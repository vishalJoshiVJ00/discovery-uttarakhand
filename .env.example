# ==============================================================================
# DISCOVERY UTTARAKHAND — ENVIRONMENT TEMPLATE (Milestone 1A)
# Copy to .env and configure for local development
# ==============================================================================

# Server Runtime
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Allowed CORS Origins (comma-separated for local frontend clients)
CORS_ORIGIN=http://localhost:5173

# Logging Level: debug | info | warn | error
LOG_LEVEL=info

