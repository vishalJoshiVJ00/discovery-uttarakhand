# ==============================================================================
# DISCOVERY UTTARAKHAND — ENVIRONMENT TEMPLATE (Milestone 1B)
# Copy to .env and configure for local development
# ==============================================================================

# Server Runtime
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Allowed CORS Origins (comma-separated for local frontend clients)
CORS_ORIGIN=http://localhost:5173

# Logging Level: debug | info | warn | error
LOG_LEVEL=info

# Database Connection (PostgreSQL 15+)
DATABASE_URL="postgresql://user:password@localhost:5432/discovery_uttarakhand?schema=public"
